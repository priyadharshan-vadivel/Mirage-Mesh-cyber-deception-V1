<!--
  ════════════════════════════════════════════════════════════════════════
   Mirage Mesh — Wazuh rules
  ════════════════════════════════════════════════════════════════════════
   Install: copy to /var/ossec/etc/rules/mirage_mesh_rules.xml on the manager,
   then restart wazuh-manager.

   Every decoy writes one JSON line per event with a top-level "mirage_mesh"
   object. The Wazuh agent reads those files with log_format=json (see
   ../agent/ossec-localfile.conf), so the fields are available to these rules
   in dot notation: mirage_mesh.decoy_layer, mirage_mesh.source_ip, etc.

   Rule IDs use the 100200 block (>=100000 is the user-custom range).
   Active response keys on the shared "mirage_mesh" group (the enclosing
   <group name="mirage_mesh,...">, carried by EVERY rule below), so it fires for
   whichever specific rule triggers. It must NOT key on the base rule's own
   mirage_mesh_decoy group: a per-layer child rule (100201-100204) is the rule
   that actually triggers and does not inherit the base rule's group.
  ════════════════════════════════════════════════════════════════════════
-->
<group name="mirage_mesh,deception,">

  <!-- Base rule: ANY decoded event that carries mirage_mesh.decoy_layer.
       All four decoys funnel through here. Level 12 (high) so it stands out on
       an otherwise calm dashboard and can drive active response. -->
  <rule id="100200" level="12">
    <decoded_as>json</decoded_as>
    <field name="mirage_mesh.decoy_layer">\.+</field>
    <description>Mirage Mesh: decoy interaction on $(mirage_mesh.decoy_layer) layer - $(mirage_mesh.event_action) from $(mirage_mesh.source_ip)</description>
    <group>mirage_mesh_decoy,</group>
  </rule>

  <!-- Per-layer child rules: cleaner dashboard grouping + per-layer MITRE tags. -->
  <rule id="100201" level="12">
    <if_sid>100200</if_sid>
    <field name="mirage_mesh.decoy_layer">^network$</field>
    <description>Mirage Mesh [NETWORK/fake SSH]: $(mirage_mesh.event_action) from $(mirage_mesh.source_ip)</description>
    <mitre><id>T1046</id><id>T1059</id><id>T1078</id><id>T1105</id><id>T1110</id></mitre>
    <group>mirage_mesh_network,</group>
  </rule>

  <rule id="100202" level="12">
    <if_sid>100200</if_sid>
    <field name="mirage_mesh.decoy_layer">^system$</field>
    <description>Mirage Mesh [SYSTEM/decoy account]: $(mirage_mesh.event_action) user $(mirage_mesh.username) from $(mirage_mesh.source_ip)</description>
    <mitre><id>T1078</id><id>T1110</id><id>T1548</id></mitre>
    <group>mirage_mesh_system,</group>
  </rule>

  <rule id="100203" level="12">
    <if_sid>100200</if_sid>
    <field name="mirage_mesh.decoy_layer">^software$</field>
    <description>Mirage Mesh [SOFTWARE/fake login]: $(mirage_mesh.event_action) from $(mirage_mesh.source_ip)</description>
    <mitre><id>T1110</id><id>T1595</id></mitre>
    <group>mirage_mesh_software,</group>
  </rule>

  <rule id="100204" level="12">
    <if_sid>100200</if_sid>
    <field name="mirage_mesh.decoy_layer">^data$</field>
    <description>Mirage Mesh [DATA/honeytoken]: $(mirage_mesh.event_action) (severity $(mirage_mesh.severity))</description>
    <mitre><id>T1552</id></mitre>
    <group>mirage_mesh_data,</group>
  </rule>

  <!-- Severity escalation: critical decoy events bump to level 14. -->
  <rule id="100210" level="14">
    <if_sid>100200</if_sid>
    <field name="mirage_mesh.severity">^critical$</field>
    <description>Mirage Mesh: CRITICAL decoy interaction - $(mirage_mesh.event_action) from $(mirage_mesh.source_ip)</description>
    <group>mirage_mesh_critical,</group>
  </rule>

</group>
